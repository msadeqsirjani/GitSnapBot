# GitSnapBot — copy to .env and fill in your values.

# --- required ---
GITHUB_TOKEN=ghp_your_token_here
TELEGRAM_BOT_TOKEN=123456:ABC-your-telegram-bot-token

# Optional. Defaults to the account that owns GITHUB_TOKEN.
# GITHUB_USERNAME=your-github-login

# Numeric chat id. Optional if you will send /start to the bot once.
# TELEGRAM_CHAT_ID=123456789

# Also notify about activity on these org logins (comma-separated).
# GITHUB_ORGS=my-org

# Track forks you own as well as original repos.
INCLUDE_OWNED_FORKS=false
INCLUDE_EVENTS=true
INCLUDE_NOTIFICATIONS=false
INCLUDE_WATCHERS=false
INCLUDE_TRAFFIC=true
INCLUDE_DELETED_CHECK=true
INCLUDE_REPO_EVENT_FALLBACK=true

# Shown on every activity card.
BOT_SIGNATURE=GitSnapBot
USER_AGENT=GitSnapBot/1.0
BOT_SHORT_DESCRIPTION=Weekly GitHub activity report for your profile.
BOT_DESCRIPTION=GitSnapBot monitors your GitHub account and delivers one scheduled report: follows, stars, forks, issues, pull requests, and related activity. Send /digest to preview the current queue.

# Weekly report (activity is queued, then sent once at this time).
DIGEST_PERIOD=weekly
DIGEST_WEEKDAY=monday
DIGEST_HOUR=9
DIGEST_MINUTE=0
DIGEST_TIMEZONE=America/Chicago
DIGEST_MAX_LINES=20
DIGEST_SEND_EMPTY=true
DIGEST_TOP_REPOS=5
# Pin the latest report; previous pins are removed first.
DIGEST_PIN=true
# Short daily summary; the weekly report remains the canonical send.
DIGEST_DAILY_BRIEF=true

# How often to poll GitHub, in seconds. 21600 = 6 hours (weekly digest does not need 45s).
POLL_INTERVAL_SECONDS=21600

# 0 = only when the count actually changed (saves the token).
FOLLOWER_RECONCILE_SECONDS=0
STAR_RECONCILE_SECONDS=0
WATCHER_RECONCILE_SECONDS=0
TRAFFIC_INTERVAL_SECONDS=0

# GitHub HTTP API
GITHUB_API_URL=https://api.github.com
GITHUB_API_VERSION=2022-11-28
GITHUB_PER_PAGE=100
GITHUB_MAX_PAGES=50
GITHUB_ACTOR_MAX_PAGES=20
GITHUB_RECEIVED_EVENT_PAGES=1
GITHUB_REPO_EVENT_PAGES=1

# Per-poll budgets for naming stargazers / forkers / departed followers
MAX_ACTORS_PER_REPO=2000
MAX_ACTOR_LOOKUPS_PER_POLL=4
MAX_ACTOR_BACKFILLS_PER_POLL=8
MAX_DEPARTURE_LOOKUPS_PER_POLL=8

# Telegram
TELEGRAM_API_URL=https://api.telegram.org
TELEGRAM_LONG_POLL_SECONDS=25
TELEGRAM_MESSAGE_LIMIT=4000
ALERT_COMPACT_THRESHOLD=4

# Runtime
HTTP_TIMEOUT_SECONDS=40
HTTP_CONNECT_TIMEOUT_SECONDS=15
ERROR_NOTICE_SECONDS=1800
EVENTS_KEEP=1500
LOG_LEVEL=INFO
LOG_COLOR=true
LOG_HTTP=true
LOG_FILE=./data/gitsnapbot.log
DATA_DIR=./data
